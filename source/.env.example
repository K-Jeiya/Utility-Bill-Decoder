# Copy this file to ".env" (same folder) and put YOUR OWN key in API_KEY.
MODEL_PROVIDER=google
MODEL_NAME=gemini-3.1-flash-lite
API_KEY=your-api-key-here

# Optional tuning (defaults shown). Leave TEMPERATURE empty to use the model default.
TEMPERATURE=
MAX_OUTPUT_ATTEMPTS=3
MAX_API_RETRIES=5
MIN_REQUEST_INTERVAL_SECONDS=4.5
REQUEST_TIMEOUT_SECONDS=180
